{
  "name": "DHT-search",
  "version": "v1.2.0",
  "description": "A self-hosted magnet link search engine built on SQLite FTS5. Dual Node/Bun runtime, background incremental indexing, on-demand search child processes, and one-command single-file exe packaging.",
  "main": "index.js",
  "scripts": {
    "start": "node scripts/win-codepage.cjs && node index.js",
    "dev:node": "node scripts/win-codepage.cjs && nodemon index.js",
    "dev:bun": "node scripts/win-codepage.cjs && bun --watch index.js",
    "dev:web": "npm --prefix web run dev",
    "build:web": "npm --prefix web run build",
    "build:exe": "npm run build:web & bun scripts/build-exe.mjs",
    "pack:zip": "node scripts/pack-zip.mjs",
    "build:zip": "npm run build:exe & npm run pack:zip",
    "smoke": "node test/smoke.mjs",
    "test": "node test/smoke.mjs",
    "seed:filter": "node scripts/seed-filter.mjs",
    "verify:driver": "node test/verify-driver.mjs",
    "test:access": "node test/access-control.mjs",
    "start:pm2:node": "pm2 start ecosystem.config.node.json",
    "start:pm2:bun": "pm2 start ecosystem.config.bun.json",
    "stop:pm2": "pm2 stop dht-search-node dht-search-bun",
    "logs:pm2": "pm2 logs"
  },
  "keywords": [
    "bittorrent",
    "dht",
    "magnet",
    "search-engine",
    "sqlite",
    "fts5",
    "full-text-search",
    "nodejs",
    "bun",
    "express",
    "self-hosted",
    "torrent"
  ],
  "author": "liuzixin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhijing-liu/DHT-search.git"
  },
  "homepage": "https://github.com/zhijing-liu/DHT-search#readme",
  "bugs": {
    "url": "https://github.com/zhijing-liu/DHT-search/issues"
  },
  "type": "module",
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "chalk": "^6.0.0",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "lru-cache": "^11.5.2",
    "node-cron": "^3.0.3",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2"
  },
  "optionalDependencies": {
    "better-sqlite3": "^13.0.3"
  },
  "devDependencies": {
    "archiver": "^8.0.0",
    "nodemon": "^3.1.14"
  }
}
